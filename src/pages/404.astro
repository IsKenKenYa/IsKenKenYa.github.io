---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh" title="404 · 页面不存在" description="页面不存在">
  <div class="flex flex-col items-center py-24 text-center">
    <p class="text-6xl font-bold tracking-tight">404</p>
    <p class="mt-4 text-zinc-500 dark:text-zinc-400">页面不存在 · Page not found</p>
    <a
      href="/"
      class="mt-8 text-sm font-medium underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900 dark:decoration-zinc-600 dark:hover:decoration-zinc-100"
    >
      返回首页 / Back to home
    </a>
  </div>
</BaseLayout>
