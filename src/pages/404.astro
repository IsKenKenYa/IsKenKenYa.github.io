---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh" title="404 · 页面不存在" description="页面不存在">
  <div class="py-24 font-mono">
    <p class="text-muted">$ curl -I <span id="req-path"></span></p>
    <p class="mt-3 text-4xl font-bold text-accent glow">404 Not Found</p>
    <p class="mt-4 text-muted">页面不存在 · Page not found</p>
    <a
      href="/"
      class="no-print mt-8 inline-block rounded-md border border-accent/50 px-4 py-2 text-sm text-accent transition hover:bg-accent hover:text-bg"
    >
      cd ~/
    </a>
  </div>
  <script is:inline>
    document.getElementById('req-path').textContent = location.pathname;
  </script>
</BaseLayout>
