---
import '../styles/global.css';
import { resume } from '../data/resume';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import LangSwitch from '../components/LangSwitch.astro';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 对应语言版本的地址（给右上角语言切换用） */
  altUrl?: string;
}

const { lang, title, description, altUrl } = Astro.props;
const t = useTranslations(lang);
const homeUrl = lang === 'zh' ? '/' : '/en/';
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      // 首屏渲染前同步主题，避免明暗闪烁；未设置过则跟随系统
      const stored = localStorage.getItem('theme');
      const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body
    class="flex min-h-dvh flex-col bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100"
  >
    <header
      class="sticky top-0 z-10 border-b border-zinc-200/70 bg-white/80 backdrop-blur print:hidden dark:border-zinc-800/70 dark:bg-zinc-950/80"
    >
      <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
        <a href={homeUrl} class="font-semibold tracking-tight">{resume.profile.name[lang]}</a>
        <nav class="flex items-center gap-0.5 text-sm" aria-label="Main">
          <a
            href={homeUrl}
            class="rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          >
            {t('nav.home')}
          </a>
          <a
            href={`${homeUrl}#projects`}
            class="rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          >
            {t('nav.projects')}
          </a>
          <LangSwitch lang={lang} altUrl={altUrl} />
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:py-14">
      <slot />
    </main>

    <footer class="border-t border-zinc-200/70 py-6 print:hidden dark:border-zinc-800/70">
      <div
        class="mx-auto flex max-w-3xl flex-col gap-2 px-4 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between dark:text-zinc-400"
      >
        <p>© {new Date().getFullYear()} {resume.profile.name[lang]}</p>
        <div class="flex items-center gap-4">
          <a
            href={resume.profile.contacts.github}
            class="transition hover:text-zinc-900 dark:hover:text-zinc-100"
            rel="me"
          >
            GitHub
          </a>
          <a
            href={`mailto:${resume.profile.contacts.email}`}
            class="transition hover:text-zinc-900 dark:hover:text-zinc-100"
          >
            {resume.profile.contacts.email}
          </a>
          <span class="text-zinc-400 dark:text-zinc-600">{t('footer.built')}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
