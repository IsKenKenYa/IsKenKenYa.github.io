---
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';
import '@fontsource/fira-code/700.css';
import '../styles/global.css';
import { resume } from '../data/resume';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import HudDecorations from '../components/HudDecorations.astro';
import Icon from '../components/Icon.astro';
import LangSwitch from '../components/LangSwitch.astro';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 对应语言版本的地址（给右上角语言切换用） */
  altUrl?: string;
}

const { lang, title, description, altUrl } = Astro.props;
const t = useTranslations(lang);
const homeUrl = lang === 'zh' ? '/' : '/en/';
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const { profile } = resume;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      // 首屏渲染前同步主题，避免明暗闪烁；未设置过则跟随系统
      const stored = localStorage.getItem('theme');
      const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body class="flex min-h-dvh flex-col text-fg antialiased">
    <HudDecorations />

    <header
      class="sticky top-0 z-10 border-b border-line bg-bg/80 backdrop-blur print:hidden"
    >
      <div class="mx-auto flex h-14 max-w-4xl items-center justify-between px-4">
        <a href={homeUrl} class="font-mono text-sm font-semibold tracking-tight">
          <span class="text-muted">~/</span>{profile.handle.toLowerCase()}<span class="text-accent">$</span>
        </a>
        <nav class="flex items-center gap-1 font-mono text-sm" aria-label="Main">
          <a
            href={homeUrl}
            class="rounded-md px-2.5 py-1.5 text-muted transition hover:bg-accent/10 hover:text-accent"
          >
            {t('nav.home')}
          </a>
          <a
            href={`${homeUrl}#projects`}
            class="rounded-md px-2.5 py-1.5 text-muted transition hover:bg-accent/10 hover:text-accent"
          >
            {t('nav.projects')}
          </a>
          <LangSwitch lang={lang} altUrl={altUrl} />
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-10 sm:py-14">
      <slot />
    </main>

    <footer class="border-t border-line py-6 print:hidden">
      <div
        class="mx-auto flex max-w-4xl flex-col gap-2 px-4 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {new Date().getFullYear()} {profile.name[lang]} · {t('footer.built')}</p>
        <div class="flex items-center gap-4">
          <a
            href={profile.contacts.github}
            class="transition hover:text-accent"
            rel="me"
          >
            github
          </a>
          <a href={`mailto:${profile.contacts.email}`} class="transition hover:text-accent">
            {profile.contacts.email}
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
