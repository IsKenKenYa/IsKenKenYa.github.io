---
import type { Project } from '../data/resume';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  lang: Lang;
  href: string;
}

const { project, lang, href } = Astro.props;
---

<a
  href={href}
  class="terminal-card group flex items-start gap-4 rounded-lg border border-line bg-card p-5 print:break-inside-avoid"
>
  <div
    class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border border-line bg-bg"
  >
    {
      project.logo ? (
        <img src={project.logo} alt="" class="h-10 w-10 object-contain" loading="lazy" />
      ) : (
        <span class="text-accent">
          <Icon name={project.icon} size={26} />
        </span>
      )
    }
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-3">
      <h3 class="text-lg font-semibold">{project.title[lang]}</h3>
      <span
        aria-hidden="true"
        class="text-muted transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent print:hidden"
      >
        ↗
      </span>
    </div>
    <p class="mt-1 text-sm text-muted">{project.tagline[lang]}</p>
    {
      project.tech && (
        <ul class="mt-2.5 flex flex-wrap gap-1.5">
          {project.tech.map((item) => (
            <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-muted">
              {item}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
