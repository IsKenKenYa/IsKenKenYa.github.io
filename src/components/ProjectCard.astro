---
import type { Project } from '../data/resume';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  href: string;
}

const { project, lang, href } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-2 rounded-xl border border-zinc-200 p-5 transition hover:border-zinc-400 hover:shadow-sm print:break-inside-avoid dark:border-zinc-800 dark:hover:border-zinc-600"
>
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-semibold">{project.title[lang]}</h3>
    <span
      aria-hidden="true"
      class="text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-zinc-600 dark:group-hover:text-zinc-300"
    >
      →
    </span>
  </div>
  <p class="text-sm text-zinc-600 dark:text-zinc-400">{project.tagline[lang]}</p>
  <ul class="mt-1 flex flex-wrap gap-1.5">
    {
      project.tech.map((item) => (
        <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
          {item}
        </li>
      ))
    }
  </ul>
</a>
