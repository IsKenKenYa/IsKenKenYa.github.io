---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section id={id} class="break-inside-avoid">
  <h2 class="mb-4 font-mono text-xs font-medium tracking-widest text-muted uppercase">
    <span class="text-accent">$</span> {title}
  </h2>
  <slot />
</section>
