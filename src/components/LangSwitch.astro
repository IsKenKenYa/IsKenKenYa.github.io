---
import { langCode, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 对应语言版本的地址；不传则不渲染切换链接 */
  altUrl?: string;
}

const { lang, altUrl } = Astro.props;
const current = langCode[lang];
const otherCode = lang === 'zh' ? langCode.en : langCode.zh;
const otherUrl = altUrl;
---

<span class="hidden items-center gap-1.5 text-xs sm:flex">
  <span class="rounded-md px-2 py-1.5 text-accent glow">[ {current} ]</span>
  {
    otherUrl && (
      <a
        href={otherUrl}
        hreflang={lang === 'zh' ? 'en' : 'zh'}
        class="rounded-md px-2 py-1.5 text-muted transition hover:bg-accent/10 hover:text-accent"
      >
        {otherCode}
      </a>
    )
  }
</span>
<!-- 移动端空间紧张，只显示切换链接 -->
{
  otherUrl && (
    <a
      href={otherUrl}
      hreflang={lang === 'zh' ? 'en' : 'zh'}
      class="rounded-md px-2 py-1.5 text-xs text-muted transition hover:bg-accent/10 hover:text-accent sm:hidden"
    >
      {otherCode}
    </a>
  )
}
