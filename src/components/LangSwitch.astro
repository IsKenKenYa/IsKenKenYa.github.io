---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 对应语言版本的地址；不传则不渲染切换链接 */
  altUrl?: string;
}

const { lang, altUrl } = Astro.props;

// 按钮上显示「另一种语言」
const label = lang === 'zh' ? 'EN' : '中文';
---

{
  altUrl && (
    <a
      href={altUrl}
      hreflang={lang === 'zh' ? 'en' : 'zh'}
      class="rounded-md px-2.5 py-1.5 text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
    >
      {label}
    </a>
  )
}
